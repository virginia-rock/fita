# Supabase project URL (Project Settings > Data API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Use the publishable key (or the legacy anon key), never a service_role/secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public app URL used by Stripe Checkout redirects.
PUBLIC_APP_URL=http://localhost:5173

# Supabase Edge Function runtime variables. Keep these out of VITE_* variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe test-mode placeholders. Create matching BRL Prices in the Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_CLOUD_MONTH=price_your-one-time-price-id
STRIPE_PRICE_SUBSCRIPTION=price_your-recurring-price-id
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-monthly-price-id
STRIPE_PRICE_PRO_ANNUAL=price_your-pro-annual-price-id
STRIPE_PRICE_PERSONAL=price_your-personal-price-id
STRIPE_PRICE_PERSONAL_PRO=price_your-personal-pro-price-id
STRIPE_PRICE_STUDIO=price_your-studio-price-id
